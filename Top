# ==========================================================
# 2. SEGA GAMEPAD (Bank 13)
# ==========================================================
# --- Распиновка (Pinout) ---
set_property PACKAGE_PIN W7 [get_ports {GP_gp_down_y}];     # "JD1_N"
set_property PACKAGE_PIN V7 [get_ports {GP_gp_up_z}];       # "JD1_P"
set_property PACKAGE_PIN V4 [get_ports {GP_gp_right_mode}]; # "JD2_N"
set_property PACKAGE_PIN V5 [get_ports {GP_gp_left_x}];     # "JD2_P"
set_property PACKAGE_PIN W5 [get_ports {GP_gp_sel}];        # "JD3_N" (Выход)
set_property PACKAGE_PIN W6 [get_ports {GP_gp_b_a}];        # "JD3_P"
set_property PACKAGE_PIN U6 [get_ports {GP_gp_c_start}];    # "JD4_P"

# --- Стандарт ввода-вывода для банка 13 (3.3V) ---
set_property IOSTANDARD LVCMOS33 [get_ports -of_objects [get_iobanks 13]]

# --- Подтяжка к питанию (PULLUP) для всех ВХОДНЫХ сигналов ---
set_property PULLTYPE PULLUP [get_ports {GP_gp_up_z}]
set_property PULLTYPE PULLUP [get_ports {GP_gp_down_y}]
set_property PULLTYPE PULLUP [get_ports {GP_gp_left_x}]
set_property PULLTYPE PULLUP [get_ports {GP_gp_right_mode}]
set_property PULLTYPE PULLUP [get_ports {GP_gp_b_a}]
set_property PULLTYPE PULLUP [get_ports {GP_gp_c_start}]
